WHATSAPP_VERIFY_TOKEN=replace-with-a-long-random-string
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v23.0
EMAIL_APPS_SCRIPT_URL=
EMAIL_APPS_SCRIPT_TOKEN=use-the-same-random-secret-as-apps-script-property
NEON_DATABASE_URL=
SESSION_SECRET=
ADMIN_EMAIL=frommahitoyou@gmail.com
ADMIN_PASSWORD_HASH=run-backend-bootstrap-admin-script-to-configure
