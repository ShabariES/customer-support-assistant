APP_ENV=development
PORT=8000
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_MONTHLY_BUDGET_INR=50000
AI_USD_TO_INR=90
GROQ_INPUT_USD_PER_M=0.075
GROQ_OUTPUT_USD_PER_M=0.30
GEMINI_INPUT_USD_PER_M=0.30
GEMINI_OUTPUT_USD_PER_M=2.50
WHISPER_USD_PER_AUDIO_HOUR=0.04
